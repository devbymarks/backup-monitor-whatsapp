# Exemplo de configuração para ambiente de execução.
# Nunca coloque credenciais reais neste arquivo.

export MONITOR_BASE_DIR='/backup/clientes'
export MONITOR_CLIENTS='nome-do-cliente:padrao-do-backup'
export MONITOR_INTERVAL_MS='1800000'
export MONITOR_INITIAL_DELAY_MS='60000'
export MONITOR_LIMIT_HOURS='24'
export MONITOR_STATE_FILE='/opt/monitor-backup/data/alerta-diario.dat'
export MONITOR_TIME_ZONE='America/Sao_Paulo'

export WHATSAPP_TOKEN='SEU_ACCESS_TOKEN'
export WHATSAPP_PHONE_NUMBER_ID='SEU_PHONE_NUMBER_ID'
export WHATSAPP_TO='SEU_NUMERO_DESTINO'
export WHATSAPP_GRAPH_VERSION='v23.0'
export WHATSAPP_MESSAGE_MODE='template'
export WHATSAPP_TEMPLATE_NAME='SEU_TEMPLATE_APROVADO'
export WHATSAPP_TEMPLATE_LANGUAGE='pt_BR'
